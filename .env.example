# Copy to .env and fill in. Never commit .env.
POSTGRES_USER=jk3d
POSTGRES_PASSWORD=change-this-password
POSTGRES_DB=jk3d

# Key that the Unreal plugin and VR app send in the X-API-Key header
API_KEY=change-this-key

# template = offline, no LLM; anthropic = LLM speech (needs ANTHROPIC_API_KEY)
LLM_PROVIDER=template
ANTHROPIC_API_KEY=
LLM_MODEL=claude-haiku-5-5

# edge = neural voices (needs internet while generating); silent = offline stub
TTS_PROVIDER=edge
VOICE_RU=ru-RU-SvetlanaNeural
VOICE_EN=en-US-JennyNeural
